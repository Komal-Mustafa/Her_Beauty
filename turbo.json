{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  },
  "globalPassThroughEnv": [
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY",
    "DATABASE_URL",
    "MEDIA_BASE_URL",
    "CORS_ORIGINS",
    "JWT_PRIVATE_KEY",
    "JWT_PUBLIC_KEY",
    "REFRESH_TOKEN_PEPPER",
    "OTP_PEPPER",
    "ENCRYPTION_KEY",
    "TRUST_PROXY",
    "TRUSTED_PROXY_HOPS",
    "CLIENT_IP_HEADER",
    "TURNSTILE_SECRET_KEY",
    "HIBP_ENABLED",
    "API_INTERNAL_URL",
    "SEED_DEMO_PASSWORD",
    "SEED_ADMIN_EMAIL"
  ],
  "globalEnv": ["NEXT_PUBLIC_*"]
}
