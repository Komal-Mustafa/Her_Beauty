# Copy to .env.local in each app. Fake values only — never commit real secrets (rules.md §1.7).
# Data source for packages/sdk: "mock" until the NestJS API exists.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SELLER_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
# Show /dev pages (3D playground) — keep false in production
NEXT_PUBLIC_ENABLE_DEV_PAGES=false

# --- API (apps/api) — local dev values from infra/docker-compose.yml ---
DATABASE_URL=postgresql://hb:hb@localhost:5432/herbeauty
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Where stored media keys are served from (R2/CDN later). Empty = keys are site paths.
MEDIA_BASE_URL=
