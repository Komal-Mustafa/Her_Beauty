# Copy to .env.local in each app. Fake values only — never commit real secrets (rules.md §1.7).
# Data source for packages/sdk: "mock" until the NestJS API exists.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SELLER_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
# Show /dev pages (3D playground) — keep false in production
NEXT_PUBLIC_ENABLE_DEV_PAGES=false

# --- API (apps/api) — local dev values from infra/docker-compose.yml ---
DATABASE_URL=postgresql://hb:hb@localhost:5432/herbeauty
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Where stored media keys are served from (R2/CDN later). Empty = keys are site paths.
MEDIA_BASE_URL=

# --- Auth (docs/b2-auth.md §9). Dev values below are fake; production MUST set real ones. ---
# Ed25519 PEM keys (PKCS8 private / SPKI public). Empty in dev = API makes a throwaway pair at boot.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
REFRESH_TOKEN_PEPPER=dev-only-refresh-pepper-change-me
OTP_PEPPER=dev-only-otp-pepper-change-me
# 32 random bytes, base64 (AES-256-GCM for 2FA secrets)
ENCRYPTION_KEY=ZGV2LW9ubHktbm90LWEtc2VjcmV0LTMyLWJ5dGVzISE=
# Express "trust proxy": which hops may set X-Forwarded-For (Next.js BFF on the same host = loopback)
TRUST_PROXY=loopback
# Next.js apps: which X-Forwarded-For entry is the visitor's IP. Proxies in front of the Next
# server that append to it (count from the right; 1 = none or one). Or name a header your edge
# sets and strips from requests (e.g. cf-connecting-ip). Leftmost values are never trusted.
TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=
# Cloudflare Turnstile — empty = CAPTCHA off (dev/test)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Check new passwords against Have I Been Pwned (k-anonymity). Off by default.
HIBP_ENABLED=false
# Server-to-server API URL used by the Next.js apps (defaults to NEXT_PUBLIC_API_BASE_URL)
API_INTERNAL_URL=http://localhost:4000/v1
# Dev seed only: password for demo accounts. Unset = demo accounts can only use OTP login.
SEED_DEMO_PASSWORD=
