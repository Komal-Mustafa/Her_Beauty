// Her Beauty (HB) — Prisma schema.
// Source of truth: docs/05-database-schema.md ("Prisma models must match this file").
//
// Conventions (doc §1):
// - uuid PKs are generated by the app (UUIDv7, see src/uuid.ts) — no DB default.
// - Money is BigInt in paisa (PKR x 100) + currency char(3). Never floats.
// - All timestamps are timestamptz (UTC).
// - Things Prisma cannot express (CHECK constraints, partial indexes, UNIQUE NULLS NOT
//   DISTINCT, RLS, ledger balance trigger, ledger_balances view, REVOKEs) live in the
//   hand-written section at the end of prisma/migrations/*_init/migration.sql.
//   Partial unique indexes are intentionally NOT declared here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3 Enum types
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  customer
  seller
  support
  finance
  admin
  super_admin

  @@map("user_role")
}

enum UserStatus {
  active
  locked
  deleted

  @@map("user_status")
}

enum SellerType {
  vendor
  manufacturer

  @@map("seller_type")
}

enum SellerStatus {
  draft
  submitted
  changes_requested
  approved
  rejected
  suspended

  @@map("seller_status")
}

enum SellerMemberRole {
  owner
  manager
  catalog
  orders
  finance

  @@map("seller_member_role")
}

enum DocStatus {
  pending
  approved
  rejected
  expired

  @@map("doc_status")
}

enum SubStatus {
  pending_payment
  active
  past_due
  cancelled
  expired

  @@map("sub_status")
}

enum BillingCycle {
  monthly
  quarterly
  yearly

  @@map("billing_cycle")
}

enum ProductStatus {
  draft
  pending_review
  live
  blocked
  archived

  @@map("product_status")
}

enum MediaType {
  image
  video
  model3d

  @@map("media_type")
}

enum MediaStatus {
  uploading
  processing
  ready
  failed

  @@map("media_status")
}

enum OrderStatus {
  awaiting_payment
  cod_pending
  paid
  partially_fulfilled
  completed
  cancelled

  @@map("order_status")
}

enum SellerOrderStatus {
  awaiting_payment
  cod_pending
  paid
  accepted
  shipped
  in_transit
  delivered
  released
  return_requested
  returned
  refunded
  disputed
  cancelled

  @@map("seller_order_status")
}

enum PaymentMethod {
  card
  jazzcash
  easypaisa
  bank_transfer
  raast
  cod
  intl_card

  @@map("payment_method")
}

enum PaymentStatus {
  created
  pending
  captured
  failed
  cancelled
  refunded
  partially_refunded

  @@map("payment_status")
}

enum RefundStatus {
  requested
  processing
  succeeded
  failed

  @@map("refund_status")
}

enum ShippingMode {
  connected
  manual
  platform

  @@map("shipping_mode")
}

enum ShipmentStatus {
  booked
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed_attempt
  returned
  cancelled

  @@map("shipment_status")
}

enum DeliveryProof {
  courier
  otp
  customer
  auto

  @@map("delivery_proof")
}

enum DisputeStatus {
  open
  seller_responded
  admin_review
  resolved_refund
  resolved_release
  closed

  @@map("dispute_status")
}

enum LedgerOwner {
  platform
  seller
  gateway
  bank
  customer

  @@map("ledger_owner")
}

enum LedgerAccountType {
  escrow
  wallet_held
  wallet_available
  revenue_commission
  revenue_plans
  revenue_ads
  gateway_clearing
  bank_clearing
  payout_pending
  cod_receivable
  fees

  @@map("ledger_account_type")
}

enum EntryDirection {
  debit
  credit

  @@map("entry_direction")
}

enum PayoutStatus {
  requested
  approved
  processing
  paid
  failed
  cancelled

  @@map("payout_status")
}

enum AdSlotCode {
  hero
  left_3d
  right_video
  category_banner
  sponsored_product

  @@map("ad_slot_code")
}

enum CreativeStatus {
  pending
  approved
  rejected

  @@map("creative_status")
}

enum CampaignStatus {
  draft
  pending
  scheduled
  live
  paused
  ended
  rejected

  @@map("campaign_status")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.1 Identity & access
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @db.Uuid
  email           String?    @unique
  /// E.164, e.g. +923001234567
  phone           String?    @unique
  /// E.164 number given at sign-up next to an email: not an identifier until verified
  /// (not unique, no codes, no sign-in; docs/b2-auth.md §3)
  pendingPhone    String?    @map("pending_phone")
  /// Argon2id; null for OTP-only customers
  passwordHash    String?    @map("password_hash")
  /// CHECK length(full_name) <= 120 (migration SQL)
  fullName        String     @map("full_name")
  role            UserRole   @default(customer)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  twofaSecretEnc  Bytes?     @map("twofa_secret_enc")
  twofaEnabledAt  DateTime?  @map("twofa_enabled_at") @db.Timestamptz(6)
  /// last accepted TOTP time-step (replay protection, docs/b2-auth.md §4)
  twofaLastStep   BigInt?    @map("twofa_last_step")
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions                   Session[]
  twofaBackupCodes           TwofaBackupCode[]
  addresses                  Address[]
  ownedSellers               Seller[]               @relation("SellerOwner")
  reviewedSellers            Seller[]               @relation("SellerReviewer")
  sellerMemberships          SellerMember[]
  reviewedSellerDocuments    SellerDocument[]
  sellerApplicationActions   SellerApplicationLog[]
  decidedBrandAuthorizations BrandAuthorization[]
  wishlists                  Wishlist[]
  cart                       Cart?
  orders                     Order[]
  orderStatusChanges         OrderStatusHistory[]
  requestedRefunds           Refund[]               @relation("RefundRequestedBy")
  approvedRefunds            Refund[]               @relation("RefundApprovedBy")
  idempotencyKeys            IdempotencyKey[]
  ledgerTransactions         LedgerTransaction[]
  requestedPayouts           Payout[]               @relation("PayoutRequestedBy")
  approvedPayouts            Payout[]               @relation("PayoutApprovedBy")
  secondApprovedPayouts      Payout[]               @relation("PayoutSecondApprover")
  resolvedReconciliations    ReconciliationIssue[]
  openedDisputes             Dispute[]              @relation("DisputeOpenedBy")
  resolvedDisputes           Dispute[]              @relation("DisputeResolvedBy")
  reviews                    Review[]
  reviewedAdCreatives        AdCreative[]
  updatedCmsPages            CmsPage[]
  notifications              Notification[]
  updatedSettings            Setting[]
  auditLogs                  AuditLog[]

  @@map("users")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// for refresh-token reuse detection
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?   @db.Inet
  /// web | seller | admin (CHECK in migration SQL)
  audience         String    @default("web")
  /// when 2FA was completed for this session family
  mfaAt            DateTime? @map("mfa_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// rotated | logout | logout_all | device_revoked | password_reset | reuse | access_lost |
  /// account_claimed (CHECK in migration SQL); only "rotated" rows trigger reuse detection
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model OtpCode {
  id        String    @id @db.Uuid
  /// phone or email (or seller_order_id for purpose = 'delivery')
  target    String
  /// login, verify, reset, delivery
  purpose   String
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  /// requester IP, for the per-IP send limit (security.md §4)
  requestIp String?   @map("request_ip") @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([target, purpose, createdAt(sort: Desc)])
  @@index([requestIp, createdAt(sort: Desc)])
  @@map("otp_codes")
}

/// 2FA backup codes: 10 per user, single use, stored as HMAC (docs/b2-auth.md §4).
model TwofaBackupCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("twofa_backup_codes")
}

/// Partial unique index one_default_address (user_id) WHERE is_default lives in migration SQL.
model Address {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// Home, Office
  label      String?
  fullName   String   @map("full_name")
  phone      String
  line1      String
  line2      String?
  area       String?
  city       String
  province   String?
  postalCode String?  @map("postal_code")
  country    String   @default("PK") @db.Char(2)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.2 Sellers (vendor & manufacturer)
// ─────────────────────────────────────────────────────────────────────────────

/// Partial unique indexes on (owner_user_id) WHERE deleted_at IS NULL and
/// (ntn) WHERE ntn IS NOT NULL AND deleted_at IS NULL live in migration SQL.
model Seller {
  id                    String       @id @db.Uuid
  ownerUserId           String       @map("owner_user_id") @db.Uuid
  type                  SellerType
  status                SellerStatus @default(draft)
  legalName             String?      @map("legal_name")
  storeName             String?      @map("store_name")
  slug                  String?      @unique
  /// sole_proprietor, partnership, private_limited
  businessType          String?      @map("business_type")
  ntn                   String?
  secpNo                String?      @map("secp_no")
  address               Json?        @db.JsonB
  city                  String?
  logoKey               String?      @map("logo_key")
  bannerKey             String?      @map("banner_key")
  about                 String?
  onboardingStep        Int          @default(1) @map("onboarding_step") @db.SmallInt
  /// basis points, 1200 = 12%
  commissionBpsOverride Int?         @map("commission_bps_override")
  /// override (new sellers 14)
  releaseHoldDays       Int?         @map("release_hold_days") @db.SmallInt
  strikes               Int          @default(0) @db.SmallInt
  submittedAt           DateTime?    @map("submitted_at") @db.Timestamptz(6)
  approvedAt            DateTime?    @map("approved_at") @db.Timestamptz(6)
  reviewedBy            String?      @map("reviewed_by") @db.Uuid
  reviewNote            String?      @map("review_note")
  onHolidayUntil        DateTime?    @map("on_holiday_until") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(6)

  owner    User  @relation("SellerOwner", fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer User? @relation("SellerReviewer", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  members             SellerMember[]
  manufacturerProfile ManufacturerProfile?
  documents           SellerDocument[]
  bankAccounts        SellerBankAccount[]
  applicationLog      SellerApplicationLog[]
  ownedBrands         Brand[]
  brandAuthorizations BrandAuthorization[]
  subscriptions       SellerSubscription[]
  products            Product[]
  sellerOrders        SellerOrder[]
  payouts             Payout[]
  invoices            SellerInvoice[]
  shippingAccounts    ShippingAccount[]
  shippingSettings    ShippingSetting?
  shippingRates       ShippingRate[]
  adSubscriptions     AdSubscription[]
  adWaitlist          AdWaitlist[]
  adCreatives         AdCreative[]
  adCampaigns         AdCampaign[]

  @@index([status])
  @@index([reviewedBy])
  @@map("sellers")
}

model SellerMember {
  sellerId  String           @map("seller_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      SellerMemberRole
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([sellerId, userId])
  @@index([userId])
  @@map("seller_members")
}

model ManufacturerProfile {
  sellerId           String    @id @map("seller_id") @db.Uuid
  factoryAddresses   Json      @default("[]") @map("factory_addresses") @db.JsonB
  productionCapacity String?   @map("production_capacity")
  /// e.g. DRAP [CONFIRM]
  regulatorName      String?   @map("regulator_name")
  licenceNo          String?   @map("licence_no")
  licenceFileKey     String?   @map("licence_file_key")
  licenceExpiry      DateTime? @map("licence_expiry") @db.Date
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("manufacturer_profiles")
}

/// ID, selfie, business papers, certificates.
/// Partial index (expires_at) WHERE status = 'approved' lives in migration SQL.
model SellerDocument {
  id         String    @id @db.Uuid
  sellerId   String    @map("seller_id") @db.Uuid
  /// cnic_front, cnic_back, selfie, ntn_cert, secp_cert, trademark, licence, halal,
  /// cruelty_free, vegan, gmp, iso
  docType    String    @map("doc_type")
  /// private bucket
  fileKey    String    @map("file_key")
  /// only last 4 digits of ID number
  idLast4    String?   @map("id_last4")
  status     DocStatus @default(pending)
  expiresAt  DateTime? @map("expires_at") @db.Date
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer User?  @relation(fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sellerId])
  @@index([reviewedBy])
  @@map("seller_documents")
}

model SellerBankAccount {
  id              String    @id @db.Uuid
  sellerId        String    @map("seller_id") @db.Uuid
  bankName        String    @map("bank_name")
  accountTitle    String    @map("account_title")
  /// AES-256-GCM by app
  ibanEnc         Bytes     @map("iban_enc")
  ibanLast4       String    @map("iban_last4")
  /// duplicate detection across sellers
  ibanHash        String    @map("iban_hash")
  isDefault       Boolean   @default(true) @map("is_default")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  /// 72 h after any change
  payoutHoldUntil DateTime? @map("payout_hold_until") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  seller  Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payouts Payout[]

  @@index([sellerId])
  @@index([ibanHash])
  @@map("seller_bank_accounts")
}

model SellerApplicationLog {
  id        String   @id @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  /// submitted, changes_requested, approved, rejected, suspended
  action    String
  note      String?
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("seller_application_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.3 Brands & protection
// ─────────────────────────────────────────────────────────────────────────────

model Brand {
  id               String    @id @db.Uuid
  name             String
  slug             String    @unique
  logoKey          String?   @map("logo_key")
  /// manufacturer that owns it
  ownerSellerId    String?   @map("owner_seller_id") @db.Uuid
  trademarkNo      String?   @map("trademark_no")
  trademarkFileKey String?   @map("trademark_file_key")
  isProtected      Boolean   @default(false) @map("is_protected")
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerSeller    Seller?              @relation(fields: [ownerSellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorizations BrandAuthorization[]
  products       Product[]

  @@index([ownerSellerId])
  @@map("brands")
}

model BrandAuthorization {
  id          String    @id @db.Uuid
  brandId     String    @map("brand_id") @db.Uuid
  sellerId    String    @map("seller_id") @db.Uuid
  documentKey String    @map("document_key")
  status      DocStatus @default(pending)
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)
  validUntil  DateTime? @map("valid_until") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seller  Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  decider User?  @relation(fields: [decidedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([brandId, sellerId])
  @@index([sellerId])
  @@index([decidedBy])
  @@map("brand_authorizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.4 Plans
// ─────────────────────────────────────────────────────────────────────────────

model SellingPlan {
  id               String   @id @db.Uuid
  /// standard, business, enterprise
  code             String   @unique
  name             String
  /// paisa
  priceMonthly     BigInt   @map("price_monthly")
  currency         String   @default("PKR") @db.Char(3)
  /// null = unlimited
  productLimit     Int?     @map("product_limit")
  imagesPerProduct Int      @map("images_per_product") @db.SmallInt
  allowVideo       Boolean  @map("allow_video")
  allow3d          Boolean  @map("allow_3d")
  staffLimit       Int      @map("staff_limit") @db.SmallInt
  /// 1500 = 15%
  commissionBps    Int      @map("commission_bps")
  adDiscountBps    Int      @default(0) @map("ad_discount_bps")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions SellerSubscription[]

  @@map("selling_plans")
}

/// Partial unique index one_active_plan (seller_id) WHERE status IN ('active','past_due')
/// and partial index (current_period_end) WHERE status = 'active' live in migration SQL.
model SellerSubscription {
  id                 String       @id @db.Uuid
  sellerId           String       @map("seller_id") @db.Uuid
  planId             String       @map("plan_id") @db.Uuid
  billingCycle       BillingCycle @default(monthly) @map("billing_cycle")
  status             SubStatus    @default(pending_payment)
  currentPeriodStart DateTime?    @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?    @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean      @default(false) @map("cancel_at_period_end")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller Seller      @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan   SellingPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sellerId])
  @@index([planId])
  @@map("seller_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.5 Catalog
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String  @id @db.Uuid
  parentId  String? @map("parent_id") @db.Uuid
  name      String
  slug      String  @unique
  iconKey   String? @map("icon_key")
  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")
  products Product[]
  adSlots  AdSlot[]

  @@index([parentId])
  @@map("categories")
}

/// RLS enabled (seller_own_products). CHECK length(title) <= 200 and partial index
/// (category_id) WHERE status = 'live' live in migration SQL.
model Product {
  id              String        @id @db.Uuid
  sellerId        String        @map("seller_id") @db.Uuid
  brandId         String        @map("brand_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  title           String
  slug            String        @unique
  /// sanitized on save
  descriptionHtml String?       @map("description_html")
  howToUse        String?       @map("how_to_use")
  ingredients     String?
  skinTypes       String[]      @default([]) @map("skin_types")
  tags            String[]      @default([])
  status          ProductStatus @default(draft)
  has3d           Boolean       @default(false) @map("has_3d")
  hasVideo        Boolean       @default(false) @map("has_video")
  ratingAvg       Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount     Int           @default(0) @map("rating_count")
  soldCount       Int           @default(0) @map("sold_count")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  seller      Seller           @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brand       Brand            @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variants    ProductVariant[]
  media       ProductMedia[]
  wishlists   Wishlist[]
  orderItems  OrderItem[]
  reviews     Review[]
  adCreatives AdCreative[]

  @@index([sellerId, status])
  @@index([brandId])
  @@map("products")
}

/// CHECKs (shade_hex format, price > 0, compare_at_price > price, stock >= 0) live in migration SQL.
model ProductVariant {
  id             String   @id @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String
  shadeName      String?  @map("shade_name")
  shadeHex       String?  @map("shade_hex") @db.Char(7)
  /// 3.5 g, 50 ml
  sizeLabel      String?  @map("size_label")
  /// paisa
  price          BigInt
  /// paisa
  compareAtPrice BigInt?  @map("compare_at_price")
  currency       String   @default("PKR") @db.Char(3)
  stock          Int      @default(0)
  weightGrams    Int      @default(100) @map("weight_grams")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media      ProductMedia[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id        String      @id @db.Uuid
  productId String      @map("product_id") @db.Uuid
  variantId String?     @map("variant_id") @db.Uuid
  type      MediaType
  fileKey   String      @map("file_key")
  posterKey String?     @map("poster_key")
  /// video provider id
  streamUid String?     @map("stream_uid")
  width     Int?
  height    Int?
  bytes     BigInt?
  status    MediaStatus @default(uploading)
  sortOrder Int         @default(0) @map("sort_order") @db.SmallInt
  altText   String?     @map("alt_text")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@map("product_media")
}

model Wishlist {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.6 Cart & orders
// ─────────────────────────────────────────────────────────────────────────────

model Cart {
  id         String   @id @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  guestToken String?  @unique @map("guest_token")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items CartItem[]

  @@map("carts")
}

/// CHECK qty BETWEEN 1 AND 20 lives in migration SQL.
model CartItem {
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  qty       Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

/// CHECK grand_total = subtotal + shipping_total - discount_total and partial index
/// (created_at) WHERE status = 'awaiting_payment' live in migration SQL.
model Order {
  id              String        @id @db.Uuid
  /// HB-260925-000123
  number          String        @unique
  customerId      String        @map("customer_id") @db.Uuid
  status          OrderStatus   @default(awaiting_payment)
  paymentMethod   PaymentMethod @map("payment_method")
  currency        String        @default("PKR") @db.Char(3)
  /// paisa
  subtotal        BigInt
  /// paisa
  shippingTotal   BigInt        @map("shipping_total")
  /// paisa
  discountTotal   BigInt        @default(0) @map("discount_total")
  /// paisa
  grandTotal      BigInt        @map("grand_total")
  addressSnapshot Json          @map("address_snapshot") @db.JsonB
  contactPhone    String        @map("contact_phone")
  idempotencyKey  String        @unique @map("idempotency_key")
  placedIp        String?       @map("placed_ip") @db.Inet
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     User          @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sellerOrders SellerOrder[]
  payments     Payment[]

  @@index([customerId, createdAt(sort: Desc)])
  @@map("orders")
}

/// RLS enabled. CHECK seller_net = subtotal + shipping_fee - commission_amount - gateway_fee_share
/// and partial indexes on release_at / shipped_at live in migration SQL.
model SellerOrder {
  id               String            @id @db.Uuid
  orderId          String            @map("order_id") @db.Uuid
  sellerId         String            @map("seller_id") @db.Uuid
  status           SellerOrderStatus
  /// paisa
  subtotal         BigInt
  /// paisa
  shippingFee      BigInt            @map("shipping_fee")
  /// frozen at order time
  commissionBps    Int               @map("commission_bps")
  /// paisa
  commissionAmount BigInt            @map("commission_amount")
  /// paisa
  gatewayFeeShare  BigInt            @default(0) @map("gateway_fee_share")
  /// paisa
  sellerNet        BigInt            @map("seller_net")
  acceptedAt       DateTime?         @map("accepted_at") @db.Timestamptz(6)
  shippedAt        DateTime?         @map("shipped_at") @db.Timestamptz(6)
  deliveredAt      DateTime?         @map("delivered_at") @db.Timestamptz(6)
  deliveryProof    DeliveryProof?    @map("delivery_proof")
  /// delivered_at + return window
  releaseAt        DateTime?         @map("release_at") @db.Timestamptz(6)
  releasedAt       DateTime?         @map("released_at") @db.Timestamptz(6)
  cancelledReason  String?           @map("cancelled_reason")
  /// optimistic locking
  version          Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order         Order                @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller        Seller               @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  refunds       Refund[]
  shipment      Shipment?
  disputes      Dispute[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt(sort: Desc)])
  @@map("seller_orders")
}

/// CHECKs qty > 0 and line_total = unit_price * qty live in migration SQL.
model OrderItem {
  id            String  @id @db.Uuid
  sellerOrderId String  @map("seller_order_id") @db.Uuid
  variantId     String  @map("variant_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  titleSnapshot String  @map("title_snapshot")
  shadeSnapshot String? @map("shade_snapshot")
  /// paisa
  unitPrice     BigInt  @map("unit_price")
  qty           Int
  /// paisa
  lineTotal     BigInt  @map("line_total")

  sellerOrder SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product     Product        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review      Review?

  @@index([sellerOrderId])
  @@index([variantId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            BigInt             @id @default(autoincrement())
  sellerOrderId String             @map("seller_order_id") @db.Uuid
  fromStatus    SellerOrderStatus? @map("from_status")
  toStatus      SellerOrderStatus  @map("to_status")
  actorId       String?            @map("actor_id") @db.Uuid
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sellerOrderId, createdAt])
  @@index([actorId])
  @@map("order_status_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.7 Payments & refunds
// ─────────────────────────────────────────────────────────────────────────────

/// CHECK amount > 0, partial unique (provider, provider_ref) WHERE provider_ref IS NOT NULL
/// and partial index (status, created_at) WHERE status IN ('created','pending') live in migration SQL.
model Payment {
  id             String        @id @db.Uuid
  /// null for plan/ad payments
  orderId        String?       @map("order_id") @db.Uuid
  /// order, selling_plan, ad_subscription, ad_addon
  purpose        String
  /// subscription id etc. (no FK: polymorphic)
  purposeRefId   String?       @map("purpose_ref_id") @db.Uuid
  /// pk_aggregator, jazzcash, easypaisa, stripe
  provider       String
  method         PaymentMethod
  /// gateway transaction id
  providerRef    String?       @map("provider_ref")
  /// paisa
  amount         BigInt
  currency       String        @db.Char(3)
  /// gateway fee (from settlement), paisa
  feeAmount      BigInt?       @map("fee_amount")
  status         PaymentStatus @default(created)
  idempotencyKey String        @unique @map("idempotency_key")
  failureCode    String?       @map("failure_code")
  capturedAt     DateTime?     @map("captured_at") @db.Timestamptz(6)
  /// masked provider response
  rawLastStatus  Json?         @map("raw_last_status") @db.JsonB
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order                Order?                @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refunds              Refund[]
  reconciliationIssues ReconciliationIssue[]

  @@index([orderId])
  @@map("payments")
}

/// CHECK amount > 0 lives in migration SQL.
model Refund {
  id             String       @id @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  sellerOrderId  String?      @map("seller_order_id") @db.Uuid
  /// paisa
  amount         BigInt
  reason         String
  status         RefundStatus @default(requested)
  providerRef    String?      @map("provider_ref")
  idempotencyKey String       @unique @map("idempotency_key")
  requestedBy    String?      @map("requested_by") @db.Uuid
  approvedBy     String?      @map("approved_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requester   User?        @relation("RefundRequestedBy", fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approver    User?        @relation("RefundApprovedBy", fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paymentId])
  @@index([sellerOrderId])
  @@index([requestedBy])
  @@index([approvedBy])
  @@map("refunds")
}

/// Partial index (received_at) WHERE processed_at IS NULL lives in migration SQL.
model WebhookEvent {
  id          String    @id @db.Uuid
  /// payment:<provider> / courier:<provider>
  source      String
  eventId     String    @map("event_id")
  signatureOk Boolean   @map("signature_ok")
  payload     Json      @db.JsonB
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?

  @@unique([source, eventId])
  @@map("webhook_events")
}

model IdempotencyKey {
  key         String   @id
  userId      String?  @map("user_id") @db.Uuid
  requestHash String   @map("request_hash")
  response    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// cleanup after 48 h
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.8 Ledger (double-entry, append-only)
// ─────────────────────────────────────────────────────────────────────────────

/// UNIQUE NULLS NOT DISTINCT (owner_type, owner_id, type, currency): declared below as a plain
/// @@unique (so Prisma does not see drift), then re-created with NULLS NOT DISTINCT in
/// migration SQL (Prisma 6 cannot express NULLS NOT DISTINCT).
model LedgerAccount {
  id        String            @id @db.Uuid
  ownerType LedgerOwner       @map("owner_type")
  /// seller id; null for platform accounts (no FK: polymorphic)
  ownerId   String?           @map("owner_id") @db.Uuid
  type      LedgerAccountType
  currency  String            @default("PKR") @db.Char(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  entries LedgerEntry[]

  @@unique([ownerType, ownerId, type, currency], map: "ledger_accounts_owner_type_owner_id_type_currency_key")
  @@map("ledger_accounts")
}

/// Append-only. UNIQUE (kind, ref_type, ref_id) is the idempotency guard for releases etc.
model LedgerTransaction {
  id        String   @id @db.Uuid
  /// payment_captured, release, refund, payout, commission, plan_fee, ad_fee
  kind      String
  refType   String   @map("ref_type")
  refId     String   @map("ref_id") @db.Uuid
  memo      String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  creator User?         @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries LedgerEntry[]

  @@unique([kind, refType, refId])
  @@index([refType, refId])
  @@index([createdBy])
  @@map("ledger_transactions")
}

/// Append-only. CHECK amount > 0 and the deferred ledger_balanced constraint trigger
/// (sum(debits) = sum(credits) per transaction) live in migration SQL.
model LedgerEntry {
  id            BigInt         @id @default(autoincrement())
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  direction     EntryDirection
  /// paisa
  amount        BigInt
  currency      String         @db.Char(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.9 Payouts & invoices
// ─────────────────────────────────────────────────────────────────────────────

/// RLS enabled. CHECK amount > 0 and partial index (status) WHERE status IN
/// ('requested','approved','processing') live in migration SQL.
model Payout {
  id             String       @id @db.Uuid
  sellerId       String       @map("seller_id") @db.Uuid
  bankAccountId  String       @map("bank_account_id") @db.Uuid
  /// paisa
  amount         BigInt
  currency       String       @default("PKR") @db.Char(3)
  status         PayoutStatus @default(requested)
  bankReference  String?      @map("bank_reference")
  requestedBy    String?      @map("requested_by") @db.Uuid
  approvedBy     String?      @map("approved_by") @db.Uuid
  /// 4-eyes above limit
  secondApprover String?      @map("second_approver") @db.Uuid
  failureReason  String?      @map("failure_reason")
  idempotencyKey String       @unique @map("idempotency_key")
  requestedAt    DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  paidAt         DateTime?    @map("paid_at") @db.Timestamptz(6)

  seller             Seller            @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bankAccount        SellerBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requester          User?             @relation("PayoutRequestedBy", fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approver           User?             @relation("PayoutApprovedBy", fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  secondApproverUser User?             @relation("PayoutSecondApprover", fields: [secondApprover], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sellerId, requestedAt(sort: Desc)])
  @@index([bankAccountId])
  @@index([requestedBy])
  @@index([approvedBy])
  @@index([secondApprover])
  @@map("payouts")
}

/// Filled by the daily reconciliation job. Partial index (run_date) WHERE status = 'open'
/// lives in migration SQL.
model ReconciliationIssue {
  id          String    @id @db.Uuid
  runDate     DateTime  @map("run_date") @db.Date
  provider    String
  /// missing_in_ledger, missing_at_gateway, amount_mismatch, fee_mismatch
  kind        String
  paymentId   String?   @map("payment_id") @db.Uuid
  providerRef String?   @map("provider_ref")
  /// paisa
  expected    BigInt?
  /// paisa
  actual      BigInt?
  /// open, resolved, ignored
  status      String    @default("open")
  resolvedBy  String?   @map("resolved_by") @db.Uuid
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolver User?    @relation(fields: [resolvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paymentId])
  @@index([resolvedBy])
  @@map("reconciliation_issues")
}

/// COD commission, plan, ads.
model SellerInvoice {
  id          String    @id @db.Uuid
  sellerId    String    @map("seller_id") @db.Uuid
  number      String    @unique
  /// cod_commission, selling_plan, ads
  kind        String
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date
  /// paisa
  amount      BigInt
  /// open, paid, void, deducted
  status      String    @default("open")
  dueAt       DateTime? @map("due_at") @db.Date
  pdfKey      String?   @map("pdf_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sellerId, createdAt(sort: Desc)])
  @@map("seller_invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.10 Shipping (seller-provided)
// ─────────────────────────────────────────────────────────────────────────────

/// RLS enabled. Courier credentials are encrypted by the app (AES-256-GCM).
model ShippingAccount {
  id               String    @id @db.Uuid
  sellerId         String    @map("seller_id") @db.Uuid
  /// tcs, leopards, postex, trax, mnp, manual
  provider         String
  label            String?
  credentialsEnc   Bytes?    @map("credentials_enc")
  credentialsLast4 String?   @map("credentials_last4")
  webhookSecretEnc Bytes?    @map("webhook_secret_enc")
  pickupAddress    Json      @map("pickup_address") @db.JsonB
  /// active, invalid, disabled
  status           String    @default("active")
  lastVerifiedAt   DateTime? @map("last_verified_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  seller            Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  defaultInSettings ShippingSetting[]
  shipments         Shipment[]

  @@index([sellerId])
  @@map("shipping_accounts")
}

/// RLS enabled.
model ShippingSetting {
  sellerId         String       @id @map("seller_id") @db.Uuid
  mode             ShippingMode @default(manual)
  defaultAccountId String?      @map("default_account_id") @db.Uuid
  handlingDays     Int          @default(1) @map("handling_days") @db.SmallInt
  /// paisa
  freeShippingMin  BigInt?      @map("free_shipping_min")
  codEnabled       Boolean      @default(true) @map("cod_enabled")
  liveQuotes       Boolean      @default(false) @map("live_quotes")

  seller         Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  defaultAccount ShippingAccount? @relation(fields: [defaultAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([defaultAccountId])
  @@map("shipping_settings")
}

/// RLS enabled. CHECK max_weight_g > min_weight_g lives in migration SQL.
model ShippingRate {
  id         String @id @db.Uuid
  sellerId   String @map("seller_id") @db.Uuid
  /// same_city, province, nationwide, remote
  zone       String
  minWeightG Int    @default(0) @map("min_weight_g")
  maxWeightG Int    @map("max_weight_g")
  /// paisa
  price      BigInt
  estDaysMin Int    @map("est_days_min") @db.SmallInt
  estDaysMax Int    @map("est_days_max") @db.SmallInt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sellerId, zone])
  @@map("shipping_rates")
}

/// Partial index (last_polled_at) WHERE status NOT IN final states lives in migration SQL.
model Shipment {
  id                String         @id @db.Uuid
  sellerOrderId     String         @unique @map("seller_order_id") @db.Uuid
  shippingAccountId String?        @map("shipping_account_id") @db.Uuid
  provider          String
  trackingNumber    String?        @map("tracking_number")
  trackingUrl       String?        @map("tracking_url")
  labelKey          String?        @map("label_key")
  status            ShipmentStatus @default(booked)
  /// paisa
  codAmount         BigInt?        @map("cod_amount")
  bookedAt          DateTime       @default(now()) @map("booked_at") @db.Timestamptz(6)
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz(6)
  proofSource       DeliveryProof? @map("proof_source")
  lastPolledAt      DateTime?      @map("last_polled_at") @db.Timestamptz(6)

  sellerOrder     SellerOrder      @relation(fields: [sellerOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shippingAccount ShippingAccount? @relation(fields: [shippingAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events          ShipmentEvent[]

  @@index([shippingAccountId])
  @@index([provider, trackingNumber])
  @@map("shipments")
}

model ShipmentEvent {
  id         BigInt         @id @default(autoincrement())
  shipmentId String         @map("shipment_id") @db.Uuid
  status     ShipmentStatus
  rawStatus  String?        @map("raw_status")
  location   String?
  message    String?
  occurredAt DateTime       @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([shipmentId, status, occurredAt])
  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.11 Returns, disputes, reviews
// ─────────────────────────────────────────────────────────────────────────────

/// Partial index (status) WHERE status is not final lives in migration SQL.
model Dispute {
  id             String        @id @db.Uuid
  sellerOrderId  String        @map("seller_order_id") @db.Uuid
  openedBy       String        @map("opened_by") @db.Uuid
  /// not_received, damaged, wrong_item, fake, other
  type           String
  description    String
  evidenceKeys   String[]      @default([]) @map("evidence_keys")
  status         DisputeStatus @default(open)
  sellerResponse String?       @map("seller_response")
  resolutionNote String?       @map("resolution_note")
  /// paisa
  refundAmount   BigInt?       @map("refund_amount")
  resolvedBy     String?       @map("resolved_by") @db.Uuid
  sellerDeadline DateTime      @map("seller_deadline") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opener      User        @relation("DisputeOpenedBy", fields: [openedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolver    User?       @relation("DisputeResolvedBy", fields: [resolvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sellerOrderId])
  @@index([openedBy])
  @@index([resolvedBy])
  @@map("disputes")
}

/// One review per bought item. CHECKs (rating 1..5, length(body) <= 2000) and partial index
/// (product_id, created_at DESC) WHERE status = 'published' live in migration SQL.
model Review {
  id          String   @id @db.Uuid
  orderItemId String   @unique @map("order_item_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  rating      Int      @db.SmallInt
  title       String?
  body        String?
  photoKeys   String[] @default([]) @map("photo_keys")
  /// published, hidden, flagged
  status      String   @default("published")
  sellerReply String?  @map("seller_reply")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product   Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer  User      @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.12 Advertising
// ─────────────────────────────────────────────────────────────────────────────

model AdPackage {
  id                     String  @id @db.Uuid
  /// glow, radiance, luxe, icon
  code                   String  @unique
  name                   String
  /// paisa
  priceMonthly           BigInt  @map("price_monthly")
  currency               String  @default("PKR") @db.Char(3)
  /// null = unlimited
  seatsTotal             Int?    @map("seats_total")
  /// null = unlimited
  sponsoredProductsLimit Int?    @map("sponsored_products_limit")
  impressionsQuota       Int     @map("impressions_quota")
  /// {"category_banner":14,"right_video":14,"left_3d":14,"hero":0}
  slotDays               Json    @map("slot_days") @db.JsonB
  features               Json    @default("{}") @db.JsonB
  isActive               Boolean @default(true) @map("is_active")
  sortOrder              Int     @default(0) @map("sort_order") @db.SmallInt

  subscriptions AdSubscription[]
  waitlist      AdWaitlist[]

  @@map("ad_packages")
}

/// RLS enabled. Partial unique index one_active_ad_sub (seller_id) WHERE status IN
/// ('active','past_due') lives in migration SQL.
model AdSubscription {
  id                 String       @id @db.Uuid
  sellerId           String       @map("seller_id") @db.Uuid
  packageId          String       @map("package_id") @db.Uuid
  billingCycle       BillingCycle @default(monthly) @map("billing_cycle")
  status             SubStatus    @default(pending_payment)
  currentPeriodStart DateTime?    @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?    @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean      @default(false) @map("cancel_at_period_end")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller    Seller       @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  package   AdPackage    @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaigns AdCampaign[]

  @@index([sellerId])
  /// seat counting
  @@index([packageId, status])
  @@map("ad_subscriptions")
}

/// RLS enabled.
model AdWaitlist {
  packageId  String    @map("package_id") @db.Uuid
  sellerId   String    @map("seller_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz(6)

  package AdPackage @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller  Seller    @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([packageId, sellerId])
  @@index([sellerId])
  @@map("ad_waitlist")
}

/// UNIQUE NULLS NOT DISTINCT (code, category_id): declared below as a plain @@unique (so Prisma
/// does not see drift), then re-created with NULLS NOT DISTINCT in migration SQL
/// (Prisma 6 cannot express NULLS NOT DISTINCT).
model AdSlot {
  id         String     @id @db.Uuid
  code       AdSlotCode
  /// for category banners
  categoryId String?    @map("category_id") @db.Uuid
  /// how many ads rotate in this slot per day
  positions  Int        @default(1) @db.SmallInt

  category Category?       @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings AdSlotBooking[]

  @@unique([code, categoryId], map: "ad_slots_code_category_id_key")
  @@index([categoryId])
  @@map("ad_slots")
}

/// RLS enabled. Partial index (status) WHERE status = 'pending' lives in migration SQL.
model AdCreative {
  id              String         @id @db.Uuid
  sellerId        String         @map("seller_id") @db.Uuid
  slotCode        AdSlotCode     @map("slot_code")
  mediaType       MediaType      @map("media_type")
  fileKey         String         @map("file_key")
  headline        String?
  ctaLabel        String?        @map("cta_label")
  targetProductId String?        @map("target_product_id") @db.Uuid
  status          CreativeStatus @default(pending)
  reviewedBy      String?        @map("reviewed_by") @db.Uuid
  rejectReason    String?        @map("reject_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  seller        Seller       @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetProduct Product?     @relation(fields: [targetProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer      User?        @relation(fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaigns     AdCampaign[]

  @@index([sellerId])
  @@index([targetProductId])
  @@index([reviewedBy])
  @@map("ad_creatives")
}

/// RLS enabled. Partial index (status) WHERE status = 'live' lives in migration SQL.
model AdCampaign {
  id             String         @id @db.Uuid
  subscriptionId String         @map("subscription_id") @db.Uuid
  sellerId       String         @map("seller_id") @db.Uuid
  name           String
  creativeId     String?        @map("creative_id") @db.Uuid
  /// sponsored products (no FK: uuid[])
  productIds     String[]       @default([]) @map("product_ids") @db.Uuid
  status         CampaignStatus @default(draft)
  startAt        DateTime?      @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?      @map("end_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription AdSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller       Seller          @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creative     AdCreative?     @relation(fields: [creativeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings     AdSlotBooking[]
  statsDaily   AdStatsDaily[]
  heroScenes   CmsHeroScene[]

  @@index([subscriptionId])
  @@index([sellerId])
  @@index([creativeId])
  @@map("ad_campaigns")
}

model AdSlotBooking {
  id         String   @id @db.Uuid
  slotId     String   @map("slot_id") @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  day        DateTime @db.Date
  position   Int      @default(1) @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  slot     AdSlot     @relation(fields: [slotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// no double booking
  @@unique([slotId, day, position])
  @@index([campaignId])
  @@index([day, slotId])
  @@map("ad_slot_bookings")
}

/// Aggregated hourly from Redis streams.
model AdStatsDaily {
  campaignId  String     @map("campaign_id") @db.Uuid
  day         DateTime   @db.Date
  slotCode    AdSlotCode @map("slot_code")
  impressions Int        @default(0)
  clicks      Int        @default(0)
  addToCarts  Int        @default(0) @map("add_to_carts")
  orders      Int        @default(0)
  /// paisa
  revenue     BigInt     @default(0)

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([campaignId, day, slotCode])
  @@map("ad_stats_daily")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.13 CMS, notifications, settings, audit
// ─────────────────────────────────────────────────────────────────────────────

model CmsHeroScene {
  id         String    @id @db.Uuid
  sortOrder  Int       @map("sort_order") @db.SmallInt
  title      String?
  subtitle   String?
  /// poster / fallback video
  mediaKey   String?   @map("media_key")
  /// optional .glb
  modelKey   String?   @map("model_key")
  /// when scene is a paid hero ad
  campaignId String?   @map("campaign_id") @db.Uuid
  startsAt   DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(6)
  isActive   Boolean   @default(true) @map("is_active")

  campaign AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([campaignId])
  @@map("cms_hero_scenes")
}

model CmsPage {
  /// about, faq, terms, privacy, refund-policy, seller-agreement
  slug      String   @id
  title     String
  bodyMd    String   @map("body_md")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("cms_pages")
}

model Notification {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// in_app, email, sms, whatsapp
  channel   String
  template  String
  data      Json      @default("{}") @db.JsonB
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  error     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Setting {
  /// return_window_days, auto_confirm_days, payout_min, four_eyes_limit, cod_max_order
  key       String   @id
  value     Json     @db.JsonB
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("settings")
}

/// Append-only (REVOKE UPDATE, DELETE, TRUNCATE from app_user in migration SQL).
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorId    String?   @map("actor_id") @db.Uuid
  actorRole  UserRole? @map("actor_role")
  /// seller.approve, refund.create, payout.approve, kyc.view ...
  action     String
  targetType String    @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  reason     String?
  ip         String?   @db.Inet
  meta       Json      @default("{}") @db.JsonB
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([targetType, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
